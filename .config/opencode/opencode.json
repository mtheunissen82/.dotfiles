{
  "$schema": "https://opencode.ai/config.json",
  "plugins": [
    "@dietrichgebert/ponytail",
    "@slkiser/opencode-quota"
  ],
  "mcp": {
    "servers": {
      "atlassian": {
        "type": "remote",
        "url": "https://mcp.atlassian.com/v2/mcp",
        "disabled": true
      },
      "datadog": {
        "type": "remote",
        "url": "https://mcp.datadoghq.com/v1/mcp",
        "disabled": true
      },
      "github": {
        "type": "local",
        "command": [
          "/Users/emty/.local/bin/github-mcp-server-local"
        ],
        "disabled": true
      },
      "slack": {
        "type": "remote",
        "url": "https://mcp.slack.com/mcp",
        "disabled": true
      },
      "tokensave": {
        "type": "local",
        "command": [
          "/opt/homebrew/bin/tokensave",
          "serve"
        ]
      }
    }
  },
  "providers": {
    "github-copilot": {
      "models": {
        "claude-haiku-5.5": {
          "variants": [
            {
              "id": "t0.2",
              "body": {
                "temperature": 0.2
              }
            }
          ]
        },
        "claude-sonnet-5.5": {
          "variants": [
            {
              "id": "t0.1",
              "body": {
                "temperature": 0.1
              }
            },
            {
              "id": "t0.2",
              "body": {
                "temperature": 0.2
              }
            },
            {
              "id": "t0.25",
              "body": {
                "temperature": 0.25
              }
            },
            {
              "id": "t0.85",
              "body": {
                "temperature": 0.85
              }
            }
          ]
        },
        "claude-opus-5.5": {
          "variants": [
            {
              "id": "t0.1",
              "body": {
                "temperature": 0.1
              }
            }
          ]
        }
      }
    }
  },
  "default_agent": "plan",
  "agents": {
    "plan": {
      "description": "System design, architeture and complex reasoning",
      "mode": "primary",
      "model": "github-copilot/claude-opus-5.5#t0.1"
    },
    "build": {
      "description": "Solution implementer",
      "mode": "primary",
      "model": "github-copilot/claude-opus-5.5#t0.1"
    },
    "review": {
      "description": "Senior engineer code review",
      "mode": "subagent",
      "model": "github-copilot/gpt-6-astra#high",
      "system": "You are a senior engineer performing a code review."
    }
  },
  "instructions": [
    "/Users/emty/.config/opencode/tokensave.md"
  ]
}
